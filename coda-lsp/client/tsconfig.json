{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "out",
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext", "DOM"],
        "sourceMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
